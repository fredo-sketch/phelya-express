# Worker pengirim Web Push. Jalankan di Railway/Render, BUKAN di Vercel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# RAHASIA: kunci service_role (Supabase > Project Settings > API Keys). Jangan masuk repo atau browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pasangan kunci dibuat sekali dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailkamu@example.com
# Opsional
POLL_INTERVAL_MS=5000
BATCH_SIZE=20
