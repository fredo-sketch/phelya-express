# Salin menjadi .env.local lalu isi dengan nilai dari Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Kunci publik VAPID untuk Web Push (aman di browser). Buat pasangan kunci: npx web-push generate-vapid-keys
# Kunci privatnya HANYA dipakai worker (lihat worker/.env.example), jangan dimasukkan ke aplikasi web.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Service_role key tidak dipakai aplikasi web. Hanya worker notifikasi yang memakainya.
