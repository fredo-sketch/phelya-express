# Salin menjadi .env.local lalu isi dengan nilai dari Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Kunci publik VAPID untuk Web Push (aman di browser). Buat pasangan kunci: npx web-push generate-vapid-keys
# Kunci privatnya HANYA dipakai worker (lihat worker/.env.example), jangan dimasukkan ke aplikasi web.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Service_role key tidak dipakai aplikasi web. Hanya worker notifikasi yang memakainya.

# --- Midtrans (Sandbox). Ambil di Midtrans Dashboard > Settings > Access Keys (mode Sandbox) ---
# Semua BUKAN NEXT_PUBLIC_: dibaca hanya di server. Client key dikirim ke browser lewat API saat pembayaran dimulai.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Dipakai HANYA oleh webhook Midtrans (/api/midtrans/notification) untuk memanggil fungsi database khusus service_role.
# Isi di Environment Variables Vercel. Jangan diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chatbot (Google AI Studio / Gemini) ---
GEMINI_API_KEY=
